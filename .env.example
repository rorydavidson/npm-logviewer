# Copy to .env next to your docker-compose file.

# Secret used to sign session cookies. REQUIRED — generate your own with:
#   openssl rand -hex 32
# Left blank on purpose: the container refuses to start without it, rather
# than running on a value published here that anyone could use to forge a
# login session.
LOGVIEWER_SECRET=

# Container timezone (affects how error-log timestamps are displayed).
TZ=Europe/London

# Optional: enable threat-detection email alerts via Resend (https://resend.com).
# Leave blank to disable email sending.
RESEND_API_KEY=
# From address for alerts. Must be a verified sender in your Resend account.
ALERT_FROM=ProxyLogs <onboarding@resend.dev>
# Public URL of the dashboard, used for clickable links in alert emails.
SITE_URL=
